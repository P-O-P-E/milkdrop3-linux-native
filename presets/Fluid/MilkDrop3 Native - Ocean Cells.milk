per_frame_1=q1=0.86*q1+0.14*bass_att;
per_frame_2=q2=0.90*q2+0.10*mid_att;
per_frame_3=q3=0.92*q3+0.08*treb_att;
comp_1=`shader_body {
comp_2=` float2 p=(uv-0.5)*aspect.xy;
comp_3=` float t=time*0.16;
comp_4=` float a=sin(p.x*5.2+sin(p.y*3.1-t*1.7)+t*2.2);
comp_5=` float b=sin(p.y*6.0+sin(p.x*3.7+t*1.3)-t*1.6);
comp_6=` float c=sin((p.x+p.y)*4.3+sin((p.x-p.y)*4.0-t)+t*1.1);
comp_7=` float flow=(a+b+c)/3.0;
comp_8=` float cells=0.5+0.5*sin(flow*4.2+p.y*2.0+q1*0.18);
comp_9=` float membrane=pow(saturate(1.0-abs(cells*2.0-1.0)),3.0);
comp_10=` float depth=saturate(0.38+0.34*flow+0.08*q2);
comp_11=` float caustic=pow(saturate(0.5+0.5*sin(flow*9.0-time*0.28)),6.0);
comp_12=` float3 deep=float3(0.003,0.035,0.075);
comp_13=` float3 teal=float3(0.015,0.44,0.62);
comp_14=` float3 cyan=float3(0.10,1.05,1.25);
comp_15=` ret=lerp(deep,teal,depth);
comp_16=` ret=lerp(ret,cyan,membrane*(0.34+0.10*saturate(q3)));
comp_17=` ret+=caustic*float3(0.10,0.38,0.48)*(0.22+0.06*saturate(q3));
comp_18=` ret*=0.82+0.18*smoothstep(0.86,0.18,length(p));
comp_19=`}
